# ============================================
# RAG QA System 配置文件
# 使用前复制此文件为 .env 并填入实际值
# ============================================

# --- LLM 配置 ---
# DeepSeek API Key（前往 https://platform.deepseek.com/ 注册获取）
LLM_API_KEY=your_deepseek_api_key_here

# DeepSeek API 基础地址
LLM_BASE_URL=https://api.deepseek.com

# DeepSeek 模型名称
LLM_MODEL_NAME=deepseek-chat

# --- Embedding 配置 ---
# HuggingFace 本地 Embedding 模型名称
EMBEDDING_MODEL=shibing624/text2vec-base-chinese
