# ============================================
# RAG QA System 配置文件
# 使用前复制此文件为 .env 并填入实际值
#   cp .env.example .env
# ============================================

# --- LLM 配置 ---
# DeepSeek API Key
# 获取方式：
#   1. 访问 https://platform.deepseek.com/
#   2. 注册账号（支持手机号）
#   3. 进入 API Keys 页面创建新 Key
#   4. 新用户通常有免费额度
LLM_API_KEY=your_deepseek_api_key_here

# DeepSeek API 基础地址（无需修改）
LLM_BASE_URL=https://api.deepseek.com

# 模型名称
#   deepseek-chat: 通用对话模型（推荐）
#   deepseek-reasoner: 推理增强模型
LLM_MODEL_NAME=deepseek-chat

# --- Embedding 配置 ---
# 中文 Embedding 模型（本地运行，首次自动下载 ~500MB）
# 备选: BAAI/bge-small-zh-v1.5, moka-ai/m3e-base
EMBEDDING_MODEL=shibing624/text2vec-base-chinese

# --- 检索配置（可选） ---
# 检索返回的文档片段数（默认 4）
# RETRIEVAL_K=4

# 文档切片大小（默认 500，需与 vector_store.py 保持一致）
# CHUNK_SIZE=500

# 文档切片重叠大小（默认 50）
# CHUNK_OVERLAP=50
